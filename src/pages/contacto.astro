---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="Contacto | Colegio Hugo Dávila" 
  description="Información de contacto del Colegio Experimental Hugo Dávila"
>
  <!-- Hero -->
  <section class="bg-[#0A2342] dark:bg-gray-950 text-white py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-[#C5A86D] dark:text-gold text-sm uppercase tracking-widest mb-4">Contacto</p>
        <h1 class="text-5xl md:text-6xl font-serif font-bold mb-6">Estamos para servirte</h1>
        <p class="text-xl text-gray-300 dark:text-gray-400">
          Comunícate con nosotros a través de los siguientes medios.
        </p>
      </div>
    </div>
  </section>

  <!-- Información de contacto -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Datos de contacto -->
      <div>
        <h2 class="text-3xl font-serif font-bold text-[#0A2342] dark:text-white mb-8">Información general</h2>
        <div class="space-y-6">
          <!-- Dirección -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#0A2342] dark:bg-gold text-white dark:text-gray-900 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-[#0A2342] dark:text-white">Dirección</h3>
              <p class="text-gray-600 dark:text-gray-300">Calle Francisco de Miranda</p>
              <p class="text-gray-600 dark:text-gray-300">GV2J+892, Miraflores, La Paz, Bolivia</p>
            </div>
          </div>
          
          <!-- Teléfono -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#0A2342] dark:bg-gold text-white dark:text-gray-900 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-[#0A2342] dark:text-white">Teléfono</h3>
              <p class="text-gray-600 dark:text-gray-300">(2) 1234567</p>
            </div>
          </div>
          
          <!-- Correo -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#0A2342] dark:bg-gold text-white dark:text-gray-900 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-[#0A2342] dark:text-white">Correo electrónico</h3>
              <p class="text-gray-600 dark:text-gray-300">info@hugodavila.edu.bo</p>
            </div>
          </div>
          
          <!-- Horario (INVIERNO) -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#0A2342] dark:bg-gold text-white dark:text-gray-900 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-[#0A2342] dark:text-white">Horario de invierno</h3>
              <p class="text-gray-600 dark:text-gray-300">Lunes a Viernes</p>
              <p class="text-gray-600 dark:text-gray-300 font-medium">8:30 AM - 12:30 PM</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Mapa -->
      <div class="bg-[#F2F4F7] dark:bg-gray-800 rounded-2xl overflow-hidden shadow-lg">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3825.5317914163397!2d-68.12168222401817!3d-16.499229040707252!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x915f20429f3958a1%3A0x95a23869f7c459cb!2sColegio%20Hugo%20D%C3%A1vila!5e0!3m2!1ses!2sbo!4v1780906176012!5m2!1ses!2sbo" 
          width="100%" 
          height="450" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full min-h-[450px]"
        ></iframe>
      </div>
    </div>
  </section>
</MainLayout>