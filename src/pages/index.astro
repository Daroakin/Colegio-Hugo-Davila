---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="Colegio Experimental Hugo Dávila | La Paz, Bolivia" 
  description="Sitio oficial del Colegio Experimental Hugo Dávila, fundado en 1952. Formando líderes en La Paz, Bolivia."
>
  <!-- Hero Video Fullscreen -->
  <section class="relative h-screen w-full overflow-hidden">
    <video 
      autoplay 
      muted 
      loop 
      playsinline 
      preload="auto"
      poster="https://res.cloudinary.com/dt8pjkb3m/video/upload/so_0/HugoDavilaIntro_bsqdpe.jpg"
      class="absolute inset-0 w-full h-full object-cover z-0"
    >
      <source 
        src="https://res.cloudinary.com/dt8pjkb3m/video/upload/q_auto,f_auto,vc_auto,w_1920,c_limit/HugoDavilaIntro_bsqdpe.mp4" 
        type="video/mp4" 
      />
    </video>
    <div class="absolute inset-0 bg-black/50 z-10"></div>

    <div class="relative z-20 flex items-end justify-center h-full pb-32 px-4">
      <h1 
        class="text-white font-serif italic font-black text-center leading-none tracking-wide"
        style="font-size: clamp(3rem, 10vw, 7rem); text-shadow: 2px 4px 12px rgba(0,0,0,0.6);"
      >
        Asesinos, las Ideas<br />no se Matan
      </h1>
    </div>

    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 animate-bounce">
      <svg class="w-6 h-6 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- Contenido de presentación -->
  <section class="bg-white dark:bg-gray-900 py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="flex flex-col items-center gap-4 mb-8">
        <div class="w-16 h-16 rounded-full bg-white dark:bg-gray-800 border-2 border-[#0A2342] dark:border-gold p-1 shadow-md">
          <img src="/images/HugoDavila.png" alt="Logo" class="w-full h-full object-contain" />
        </div>
        <span class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wider">Desde 1952</span>
      </div>

      <h2 class="text-4xl md:text-5xl font-serif font-bold text-[#0A2342] dark:text-white mb-6">
        Colegio Experimental Hugo Dávila
      </h2>

      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        Formando generaciones de líderes en La Paz desde 1952. Institución pionera en educación secundaria experimental, reconocida por la UNESCO.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/comunicados" class="bg-[#C5A86D] text-[#0A2342] dark:text-gray-900 font-semibold px-8 py-3 rounded-lg hover:bg-opacity-90 transition-all shadow-md hover:shadow-lg">
          Ver comunicados
        </a>
        <a href="/nosotros" class="border-2 border-[#0A2342] dark:border-gray-300 text-[#0A2342] dark:text-gray-200 font-semibold px-8 py-3 rounded-lg hover:bg-[#0A2342] hover:text-white dark:hover:bg-gray-600 transition-all">
          Nuestra historia
        </a>
      </div>
    </div>
  </section>

  <!-- Cifras clave -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-5xl font-serif font-bold text-navy-900 dark:text-white mb-2">1952</div>
          <div class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wide">Año de fundación</div>
        </div>
        <div>
          <div class="text-5xl font-serif font-bold text-navy-900 dark:text-white mb-2">1,250</div>
          <div class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wide">Estudiantes</div>
        </div>
        <div>
          <div class="text-5xl font-serif font-bold text-navy-900 dark:text-white mb-2">70</div>
          <div class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wide">Profesores</div>
        </div>
        <div>
          <div class="text-5xl font-serif font-bold text-navy-900 dark:text-white mb-2">35</div>
          <div class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wide">Aulas</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pilares -->
  <section class="py-20 bg-silver dark:bg-gray-800">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-serif font-bold text-navy-900 dark:text-white mb-4">Nuestros pilares</h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          Una educación integral basada en la excelencia académica y la formación en valores.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white dark:bg-gray-700 p-10 rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-500 group">
          <div class="w-14 h-14 bg-navy-900 dark:bg-gold text-white dark:text-gray-900 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 4 3 8 3s8-1 8-3v-5"/></svg>
          </div>
          <h3 class="text-xl font-serif font-bold text-navy-900 dark:text-white mb-3">Excelencia Académica</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            Programas educativos de alto nivel, reconocidos por la UNESCO desde 1978.
          </p>
        </div>
        
        <div class="bg-white dark:bg-gray-700 p-10 rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-500 group">
          <div class="w-14 h-14 bg-navy-900 dark:bg-gold text-white dark:text-gray-900 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="text-xl font-serif font-bold text-navy-900 dark:text-white mb-3">Comunidad</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            1,250 estudiantes y 70 profesores forman una comunidad unida en dos turnos.
          </p>
        </div>
        
        <div class="bg-white dark:bg-gray-700 p-10 rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-500 group">
          <div class="w-14 h-14 bg-navy-900 dark:bg-gold text-white dark:text-gray-900 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3 class="text-xl font-serif font-bold text-navy-900 dark:text-white mb-3">Tradición</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            Más de 70 años de historia formando líderes en La Paz.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Instalaciones -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-serif font-bold text-navy-900 dark:text-white mb-4">Nuestras instalaciones</h2>
        <p class="text-gray-600 dark:text-gray-300">Espacios diseñados para el desarrollo integral de nuestros estudiantes.</p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="bg-silver dark:bg-gray-800 p-8 rounded-xl text-center hover:bg-navy-900 dark:hover:bg-gray-700 hover:text-white transition-all duration-500 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-navy-900 dark:text-gold group-hover:text-gold transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <p class="font-semibold">Biblioteca</p>
        </div>
        <div class="bg-silver dark:bg-gray-800 p-8 rounded-xl text-center hover:bg-navy-900 dark:hover:bg-gray-700 hover:text-white transition-all duration-500 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-navy-900 dark:text-gold group-hover:text-gold transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
          <p class="font-semibold">Lab. Física</p>
        </div>
        <div class="bg-silver dark:bg-gray-800 p-8 rounded-xl text-center hover:bg-navy-900 dark:hover:bg-gray-700 hover:text-white transition-all duration-500 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-navy-900 dark:text-gold group-hover:text-gold transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
          <p class="font-semibold">Lab. Química</p>
        </div>
        <div class="bg-silver dark:bg-gray-800 p-8 rounded-xl text-center hover:bg-navy-900 dark:hover:bg-gray-700 hover:text-white transition-all duration-500 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-navy-900 dark:text-gold group-hover:text-gold transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="12" y2="15"/></svg>
          <p class="font-semibold">Computación</p>
        </div>
        <div class="bg-silver dark:bg-gray-800 p-8 rounded-xl text-center hover:bg-navy-900 dark:hover:bg-gray-700 hover:text-white transition-all duration-500 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-navy-900 dark:text-gold group-hover:text-gold transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 16.2A4.5 4.5 0 0 0 17.5 8h-1.8A7 7 0 1 0 4 14.9"/><path d="M12 12v9"/><path d="M16 16l-4-4-4 4"/></svg>
          <p class="font-semibold">Gimnasio</p>
        </div>
        <div class="bg-silver dark:bg-gray-800 p-8 rounded-xl text-center hover:bg-navy-900 dark:hover:bg-gray-700 hover:text-white transition-all duration-500 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-navy-900 dark:text-gold group-hover:text-gold transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
          <p class="font-semibold">Teatro</p>
        </div>
        <div class="bg-silver dark:bg-gray-800 p-8 rounded-xl text-center hover:bg-navy-900 dark:hover:bg-gray-700 hover:text-white transition-all duration-500 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-navy-900 dark:text-gold group-hover:text-gold transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <p class="font-semibold">Anfiteatro</p>
        </div>
        <div class="bg-silver dark:bg-gray-800 p-8 rounded-xl text-center hover:bg-navy-900 dark:hover:bg-gray-700 hover:text-white transition-all duration-500 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-navy-900 dark:text-gold group-hover:text-gold transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <p class="font-semibold">4 Canchas</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Logros -->
  <section class="py-20 bg-navy-900 dark:bg-gray-950 text-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-serif font-bold mb-4">Logros recientes</h2>
        <p class="text-gray-400">Nuestros estudiantes destacan en competencias a nivel nacional.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-gold flex items-center justify-center flex-shrink-0 mt-1">
            <svg class="w-4 h-4 text-navy-900" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          </div>
          <div>
            <p class="text-sm text-gold mb-1">2025</p>
            <p class="text-lg text-white">Primer lugar en fútbol varones Copa Univalle (T.M.)</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-gold flex items-center justify-center flex-shrink-0 mt-1">
            <svg class="w-4 h-4 text-navy-900" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          </div>
          <div>
            <p class="text-sm text-gold mb-1">2024</p>
            <p class="text-lg text-white">Primer lugar en fútbol femenino Copa Univalle (T.M.)</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-gold flex items-center justify-center flex-shrink-0 mt-1">
            <svg class="w-4 h-4 text-navy-900" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          </div>
          <div>
            <p class="text-sm text-gold mb-1">2019</p>
            <p class="text-lg text-white">Primer lugar en futsal y voleibol del municipio de La Paz</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-gold flex items-center justify-center flex-shrink-0 mt-1">
            <svg class="w-4 h-4 text-navy-900" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          </div>
          <div>
            <p class="text-sm text-gold mb-1">2018</p>
            <p class="text-lg text-white">Primer puesto en Teatro y Bandas ARUSA</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA Final -->
  <section class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-4xl mx-auto text-center px-6">
      <h2 class="text-4xl font-serif font-bold text-navy-900 dark:text-white mb-6">¿Quieres estar al día?</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-10 text-lg">Revisa nuestros comunicados oficiales para conocer las últimas noticias y anuncios del colegio.</p>
      <a href="/comunicados" class="bg-gold text-navy-900 dark:text-gray-900 font-semibold px-10 py-5 rounded-lg hover:bg-gold/90 transition-all shadow-lg text-lg">
        Ver todos los comunicados
      </a>
    </div>
  </section>
</MainLayout>