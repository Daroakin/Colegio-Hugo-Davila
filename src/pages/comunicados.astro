---
import MainLayout from '../layouts/MainLayout.astro';

const comunicados = await Astro.glob('../content/comunicados/*.md');

const comunicadosConSlug = comunicados.map(comunicado => ({
  ...comunicado,
  slug: comunicado.file.split('/').pop()?.replace('.md', ''),
}));

comunicadosConSlug.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date).getTime();
  const dateB = new Date(b.frontmatter.date).getTime();
  return dateB - dateA;
});
---

<MainLayout 
  title="Comunicados | Colegio Hugo Dávila" 
  description="Comunicados oficiales del Colegio Experimental Hugo Dávila"
>
  <!-- Hero -->
  <section class="bg-[#0A2342] text-white py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl" data-aos="fade-up">
        <p class="text-[#C5A86D] text-sm uppercase tracking-widest mb-4">Información oficial</p>
        <h1 class="text-5xl md:text-6xl font-serif font-bold mb-6">Comunicados</h1>
        <p class="text-xl text-gray-300">Mantente informado de las últimas noticias.</p>
      </div>
    </div>
  </section>

  <!-- Lista de comunicados -->
  <section class="py-20 bg-[#F2F4F7]">
    <div class="max-w-7xl mx-auto px-6">
      {comunicadosConSlug.length === 0 ? (
        <div class="text-center py-20" data-aos="fade-up">
          <div class="w-20 h-20 bg-[#0A2342] text-white rounded-2xl flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h2 class="text-2xl font-serif font-bold text-[#0A2342] mb-3">No hay comunicados aún</h2>
          <p class="text-gray-600">Próximamente podrás ver aquí todas las novedades.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {comunicadosConSlug.map((comunicado, index) => (
            <a href={`/comunicados/${comunicado.slug}`} class="block group">
              <article class="bg-white rounded-2xl shadow-sm overflow-hidden hover:shadow-xl transition-all duration-500"
                data-aos="fade-up" data-aos-delay={index * 100}
              >
                {comunicado.frontmatter.image && (
                  <div class="overflow-hidden h-48">
                    <img src={comunicado.frontmatter.image} alt={comunicado.frontmatter.title} 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"/>
                  </div>
                )}
                <div class="p-8">
                  <time class="text-xs text-[#C5A86D] uppercase tracking-wider font-medium mb-3 block">
                    {new Date(comunicado.frontmatter.date).toLocaleDateString('es-BO', {
                      year: 'numeric', month: 'long', day: 'numeric'
                    })}
                  </time>
                  <h3 class="text-xl font-serif font-bold text-[#0A2342] mb-4 group-hover:text-[#C5A86D] transition-colors">
                    {comunicado.frontmatter.title}
                  </h3>
                  <p class="text-gray-600 leading-relaxed line-clamp-3 mb-6">{comunicado.body}</p>
                  <span class="inline-flex items-center text-[#0A2342] font-medium text-sm group-hover:text-[#C5A86D] transition-colors">
                    Leer comunicado
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" 
                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </article>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</MainLayout>