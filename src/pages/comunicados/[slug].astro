---
import MainLayout from '../../layouts/MainLayout.astro';
import { marked } from 'marked';

export async function getStaticPaths() {
  const comunicados = await Astro.glob('../../content/comunicados/*.md');
  return comunicados.map(comunicado => {
    const rawContent = comunicado.rawContent?.() || '';
    const contenidoHTML = marked(rawContent);
    return {
      params: { slug: comunicado.file.split('/').pop()?.replace('.md', '') },
      props: {
        frontmatter: comunicado.frontmatter,
        contenido: contenidoHTML,
        image: comunicado.frontmatter.image || null,
      },
    };
  });
}

const { frontmatter, contenido, image } = Astro.props;
---

<MainLayout title={`${frontmatter.title} | Comunicados`}>
  <article class="max-w-4xl mx-auto px-6 py-20 text-gray-800 dark:text-gray-200">
    <a href="/comunicados" class="text-[#C5A86D] dark:text-gold text-sm uppercase tracking-wider mb-4 inline-block hover:underline">
      ← Volver a comunicados
    </a>
    <time class="text-sm text-gray-500 dark:text-gray-400 block mb-2">
      {new Date(frontmatter.date).toLocaleDateString('es-BO', {
        year: 'numeric', month: 'long', day: 'numeric'
      })}
    </time>
    <h1 class="text-4xl md:text-5xl font-serif font-bold text-[#0A2342] dark:text-white mb-8">
      {frontmatter.title}
    </h1>
    {image && (
      <img src={image} alt={frontmatter.title} 
           class="w-full h-64 object-cover rounded-2xl mb-8 shadow" />
    )}
    <div class="prose dark:prose-invert max-w-none prose-headings:text-[#0A2342] dark:prose-headings:text-white prose-strong:text-[#0A2342] dark:prose-strong:text-white prose-a:text-[#C5A86D]">
      <Fragment set:html={contenido} />
    </div>
  </article>
</MainLayout>