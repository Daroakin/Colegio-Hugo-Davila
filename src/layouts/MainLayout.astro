---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Colegio Experimental Hugo Dávila - Sitio Oficial' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/HugoDavila.png" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <style is:global>
      #mainHeader {
        transition: transform 0.3s ease, opacity 0.3s ease;
      }
      #mainHeader.header-hidden {
        transform: translateY(-100%);
        opacity: 0;
      }
    </style>
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-200 font-sans antialiased transition-colors duration-300">
    
    <header id="mainHeader" class="sticky top-0 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-100 dark:border-gray-800 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 md:px-6 py-3 md:py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 md:gap-4 group">
          <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-white dark:bg-gray-800 border-2 border-navy-900 dark:border-gold overflow-hidden p-1 shadow-md group-hover:scale-105 transition-transform duration-300">
            <img src="/images/HugoDavila.png" alt="Logo" class="w-full h-full object-contain" />
          </div>
          <div class="text-left">
            <h1 class="text-sm md:text-lg font-serif font-bold text-navy-900 dark:text-white leading-tight">Colegio Experimental</h1>
            <p class="text-[10px] md:text-xs text-navy-800 dark:text-gold font-medium tracking-wide">HUGO DÁVILA</p>
          </div>
        </a>
        
        <nav class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-navy-900 dark:hover:text-gold transition-colors">Inicio</a>
          <a href="/nosotros" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-navy-900 dark:hover:text-gold transition-colors">Nosotros</a>
          <a href="/comunicados" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-navy-900 dark:hover:text-gold transition-colors">Comunicados</a>
          <a href="/contacto" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-navy-900 dark:hover:text-gold transition-colors">Contacto</a>
        </nav>
        
        <div class="flex items-center gap-3">
          <button id="themeToggle" class="relative w-10 h-5 md:w-12 md:h-6 rounded-full bg-gray-300 dark:bg-navy-800 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-gold">
            <span class="absolute top-0.5 left-0.5 w-4 h-4 md:w-5 md:h-5 rounded-full bg-white dark:bg-gold shadow-md transform transition-transform duration-300 dark:translate-x-5 md:dark:translate-x-6 flex items-center justify-center text-[10px] md:text-xs">
              <span class="block dark:hidden">☀️</span>
              <span class="hidden dark:block">🌙</span>
            </span>
          </button>
          
          <button id="hamburgerBtn" class="md:hidden text-navy-900 dark:text-white focus:outline-none" aria-label="Abrir menú">
            <svg id="hamburgerIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="closeIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mobileMenu" class="md:hidden hidden bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800 shadow-lg">
        <nav class="flex flex-col px-6 py-4 space-y-3">
          <a href="/" class="mobile-link text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-navy-900 dark:hover:text-gold transition-colors py-2">Inicio</a>
          <a href="/nosotros" class="mobile-link text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-navy-900 dark:hover:text-gold transition-colors py-2">Nosotros</a>
          <a href="/comunicados" class="mobile-link text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-navy-900 dark:hover:text-gold transition-colors py-2">Comunicados</a>
          <a href="/contacto" class="mobile-link text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-navy-900 dark:hover:text-gold transition-colors py-2">Contacto</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-navy-900 dark:bg-gray-950 text-white py-12">
      <div class="max-w-3xl mx-auto px-4 text-center space-y-4">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-white p-1">
            <img src="/images/HugoDavila.png" alt="Logo" class="w-full h-full object-contain" />
          </div>
          <div class="text-left">
            <h3 class="font-serif font-bold text-lg">Colegio Experimental Hugo Dávila</h3>
            <p class="text-xs text-gray-400">Formando líderes desde 1952</p>
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-sm text-gray-300">
          <p>📍 José Carrasco s/n, Miraflores</p>
          <p>🏙️ La Paz, Bolivia</p>
          <p>🌅 Turno Mañana: Lic. Juan Rivera</p>
        </div>
        
        <div class="pt-6 mt-6 border-t border-white/10 text-xs text-gray-400">
          <p>&copy; {new Date().getFullYear()} Colegio Experimental Hugo Dávila. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>

    <script>
      (function() {
        const hash = window.location.hash;
        
        // Si hay un token de invitación, confirmación o recuperación
        if (hash.includes('invite_token=') || hash.includes('confirmation_token=') || hash.includes('recovery_token=')) {
          // Redirigir al panel de admin con el hash intacto
          window.location.href = '/admin/' + hash;
        }
      })();
    </script>
    
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (typeof AOS !== 'undefined') {
          AOS.init({ duration: 800, once: true, offset: 100 });
        }

        const themeToggle = document.getElementById('themeToggle');
        if (themeToggle) {
          themeToggle.addEventListener('click', function () {
            const html = document.documentElement;
            html.classList.toggle('dark');
            localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
          });
        }

        const hamburgerBtn = document.getElementById('hamburgerBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const hamburgerIcon = document.getElementById('hamburgerIcon');
        const closeIcon = document.getElementById('closeIcon');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        function closeMenu() {
          mobileMenu.classList.add('hidden');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }

        function toggleMenu() {
          mobileMenu.classList.toggle('hidden');
          hamburgerIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        }

        if (hamburgerBtn) {
          hamburgerBtn.addEventListener('click', toggleMenu);
        }

        mobileLinks.forEach(link => {
          link.addEventListener('click', closeMenu);
        });

        // Smart Header
        const header = document.getElementById('mainHeader');
        let lastScrollY = window.scrollY;
        let ticking = false;

        function updateHeader() {
          const currentScrollY = window.scrollY;
          
          if (currentScrollY > 50) {
            if (currentScrollY > lastScrollY) {
              header.classList.add('header-hidden');
              if (!mobileMenu.classList.contains('hidden')) {
                closeMenu();
              }
            } else {
              header.classList.remove('header-hidden');
            }
          } else {
            header.classList.remove('header-hidden');
          }
          
          lastScrollY = currentScrollY;
          ticking = false;
        }

        window.addEventListener('scroll', function () {
          if (!ticking) {
            window.requestAnimationFrame(updateHeader);
            ticking = true;
          }
        });
      });
    </script>
  </body>
</html>